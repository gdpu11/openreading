{
  "appId": "cn.ixiaoshi.openreading",
  "productName": "Open Reading",
  "directories": {
    "output": "release/desktop"
  },
  "files": [
    "desktop/main.cjs",
    "desktop/preload.cjs",
    "desktop/reading-tools.cjs",
    "desktop/open-files.cjs",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "desktop/mobile",
      "to": "mobile"
    },
    {
      "from": "desktop/runtime",
      "to": "runtime"
    },
    {
      "from": "internal/server/static/licenses",
      "to": "licenses"
    }
  ],
  "protocols": [{ "name": "Open Reading", "schemes": ["openreading"] }],
  "asar": true,
  "npmRebuild": false,
  "publish": null,
  "mac": {
    "category": "public.app-category.books",
    "target": ["dmg", "zip"],
    "identity": null,
    "icon": "desktop/assets/icon.icns",
    "extendInfo": {
      "NSLocalNetworkUsageDescription": "手机在同一局域网连接这台电脑，同步阅读文件和学习笔记。",
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "EPUB e-book",
          "CFBundleTypeExtensions": ["epub"],
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["org.idpf.epub-container"],
          "CFBundleTypeIconFile": "icon.icns"
        }
      ]
    },
    "artifactName": "Open-Reading-${version}-macOS-${arch}.${ext}"
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "desktop/assets/icon.ico",
    "artifactName": "Open-Reading-${version}-Windows-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Open-Reading-${version}-Windows-${arch}-setup.${ext}"
  },
  "afterPack": "./scripts/verify-desktop.mjs"
}
