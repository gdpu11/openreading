{
  "name": "openreading",
  "version": "1.6.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/copy-assets.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:pack": "node scripts/package-desktop.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "desktop:pack:mac:intel": "node scripts/package-desktop.mjs --mac --x64",
    "desktop:pack:mac:arm64": "node scripts/package-desktop.mjs --mac --arm64",
    "desktop:pack:windows": "node scripts/package-desktop.mjs --win --x64",
    "test:desktop-packaging": "node --test scripts/desktop-packaging.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@lingo-reader/mobi-parser": "0.4.6",
    "core-js": "3.50.0",
    "dompurify": "3.4.17",
    "epubjs": "0.3.93",
    "jszip": "3.10.2",
    "katex": "0.19.0",
    "lucide-react": "1.59.0",
    "mammoth": "1.13.0",
    "node-unrar-js": "2.0.2",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rtf.js": "3.0.9"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "epubjs": {
      "@xmldom/xmldom": "^0.9.0"
    },
    "mammoth": {
      "@xmldom/xmldom": "^0.9.0"
    },
    "global-agent": "4.1.3",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "productName": "Open Reading",
  "description": "Open Reading — files, reading and notes across your devices",
  "author": "Open Reading contributors",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdpu11/openreading.git"
  },
  "homepage": "https://github.com/gdpu11/openreading"
}
